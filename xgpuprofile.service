[Unit]
Description=Choose the GPU layout before the display server starts
Documentation=man:xgpuprofile(1)
# Display managers install this alias, so ordering before it means the
# layout is settled by the time Xorg is launched. Harmless if no display
# manager is installed and X is started by hand.
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Short delay a blunt but reliable way to ensure external displays are
# initialized properly.
ExecStartPre=/bin/sleep 2
ExecStart=@BINDIR@/xgpuprofile --refresh

[Install]
WantedBy=multi-user.target
