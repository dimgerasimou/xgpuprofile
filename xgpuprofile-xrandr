#!/bin/sh
# xgpuprofile-xrandr
#
# The runtime half of xgpuprofile. The xorg.conf.d fragment can put the
# discrete GPU in charge and keep the integrated one present, but it
# cannot connect them: attaching the integrated GPU's outputs as a sink
# for the discrete one is an xrandr call, and xrandr needs a running X
# server. So this runs from the session startup instead.
#
# Without it the built-in panel stays dark whenever the fragment is
# active, because nothing is scanning out for it.
#
# Source or run this from ~/.xinitrc (before exec'ing the window manager),
# or from your display manager's session startup.
#
# Safe to run unconditionally: when the fragment is absent there is no
# NVIDIA provider to pair, and it does nothing.

set -e

SOURCE_PROVIDER="${XGPUPROFILE_SOURCE:-NVIDIA-0}"
SINK_PROVIDER="${XGPUPROFILE_SINK:-modesetting}"

command -v xrandr >/dev/null 2>&1 || exit 0

providers=$(xrandr --listproviders 2>/dev/null) || exit 0

# Both halves must be present: the discrete GPU renders, the integrated one
# scans out for it.
case "$providers" in
	*"name:$SOURCE_PROVIDER"*) ;;
	*) exit 0 ;;
esac

case "$providers" in
	*"name:$SINK_PROVIDER"*) ;;
	*) exit 0 ;;
esac

xrandr --setprovideroutputsource "$SINK_PROVIDER" "$SOURCE_PROVIDER"
xrandr --auto
